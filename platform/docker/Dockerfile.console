# syntax=docker/dockerfile:1.7
# Build with context platform/ and target console-PLATFORM.
FROM ubuntu:24.04 AS base
ENV DEBIAN_FRONTEND=noninteractive CARGO_HOME=/opt/cargo RUSTUP_HOME=/opt/rustup
ENV PATH="/opt/cargo/bin:${PATH}"
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl git cmake ninja-build python3 file \
    zip unzip xz-utils pkg-config libssl-dev libgmp10 libmpfr6 libmpc3 \
    && rm -rf /var/lib/apt/lists/*
COPY consoles/toolchain.env /tmp/toolchain.env
COPY docker/install-console-rust.sh /tmp/install-rust.sh
WORKDIR /work

FROM base AS console-ps3
RUN bash /tmp/install-rust.sh
ARG PS3DEV_VERSION=nightly-2026-07-26
RUN apt-get update && apt-get install -y --no-install-recommends libelf1 libtinfo6 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/ps3dev \
    && curl -fL --retry 3 "https://github.com/ps3dev/ps3dev/releases/download/${PS3DEV_VERSION}/ps3dev-linux-X64.tar.gz" -o /tmp/sdk.tar.gz \
    && tar -xzf /tmp/sdk.tar.gz --strip-components=1 -C /opt/ps3dev \
    && rm /tmp/sdk.tar.gz \
    && /opt/ps3dev/ppu/bin/powerpc64-ps3-elf-gcc --version \
    && test -f /opt/ps3dev/ppu/lib/liblv2.a \
    && test -x /opt/ps3dev/bin/cgcomp && test -x /opt/ps3dev/bin/make_self
ENV PS3DEV=/opt/ps3dev PSL1GHT=/opt/ps3dev
ENV PATH="/opt/ps3dev/bin:/opt/ps3dev/ppu/bin:/opt/ps3dev/spu/bin:${PATH}"

# Pin the full official SDK image, including the vita2d target library.
FROM vitasdk/vitasdk@sha256:fd82d88ff456d118eef16533ebf9a3a6ae0e292684fb8a3a35f15f0707b4692d AS console-psv
USER root
ENV DEBIAN_FRONTEND=noninteractive CARGO_HOME=/opt/cargo RUSTUP_HOME=/opt/rustup
ENV PATH="/opt/cargo/bin:${PATH}"
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl git python3 file zip unzip pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
COPY consoles/toolchain.env /tmp/toolchain.env
COPY docker/install-console-rust.sh /tmp/install-rust.sh
RUN bash /tmp/install-rust.sh && cargo install cargo-vita --version 0.2.2 --locked \
    && test -f "$VITASDK/arm-vita-eabi/lib/libvita2d.a"
WORKDIR /work

FROM devkitpro/devkita64:20260219 AS console-switch
ENV DEBIAN_FRONTEND=noninteractive CARGO_HOME=/opt/cargo RUSTUP_HOME=/opt/rustup
ENV PATH="/opt/cargo/bin:${PATH}"
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl git python3 file zip unzip pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
COPY consoles/toolchain.env /tmp/toolchain.env
COPY docker/install-console-rust.sh /tmp/install-rust.sh
RUN bash /tmp/install-rust.sh && test -f /opt/devkitpro/libnx/lib/libnx.a
WORKDIR /work

FROM base AS llvm
# The R5900 backend and its erratum fix require LLVM 23.
RUN curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key -o /etc/apt/trusted.gpg.d/llvm.asc \
    && echo 'deb https://apt.llvm.org/noble/ llvm-toolchain-noble-23 main' > /etc/apt/sources.list.d/llvm.list \
    && apt-get update && apt-get install -y --no-install-recommends llvm-23 \
    && rm -rf /var/lib/apt/lists/*
ENV LLVM=/usr/lib/llvm-23/bin

FROM llvm AS console-ps1
RUN bash /tmp/install-rust.sh
ARG PSN00BSDK_VERSION=0.24
RUN curl -fL --retry 3 "https://github.com/Lameguy64/PSn00bSDK/releases/download/v${PSN00BSDK_VERSION}/PSn00bSDK-${PSN00BSDK_VERSION}-Linux.zip" -o /tmp/sdk.zip \
    && unzip -q /tmp/sdk.zip -d /opt \
    && mv "/opt/PSn00bSDK-${PSN00BSDK_VERSION}-Linux" /opt/psn00bsdk \
    && rm /tmp/sdk.zip \
    && /opt/psn00bsdk/bin/mipsel-none-elf-gcc --version \
    && /opt/psn00bsdk/bin/mkpsxiso -h >/dev/null
ENV PSN00BSDK=/opt/psn00bsdk PSN00BSDK_TC=/opt/psn00bsdk
ENV PATH="/opt/psn00bsdk/bin:${PATH}"

FROM llvm AS console-ps2
RUN bash /tmp/install-rust.sh legacy
ARG PS2DEV_VERSION=v2.0.0
RUN mkdir -p /opt/ps2dev \
    && curl -fL --retry 3 "https://github.com/ps2dev/ps2dev/releases/download/${PS2DEV_VERSION}/ps2dev-ubuntu-latest.tar.gz" -o /tmp/sdk.tar.gz \
    && tar -xzf /tmp/sdk.tar.gz --strip-components=1 -C /opt/ps2dev \
    && rm /tmp/sdk.tar.gz \
    && /opt/ps2dev/ee/bin/mips64r5900el-ps2-elf-gcc --version \
    && test -f /opt/ps2dev/gsKit/lib/libgskit.a \
    && "$LLVM/llc" --version | grep -q mips
ENV PS2DEV=/opt/ps2dev PS2SDK=/opt/ps2dev/ps2sdk GSKIT=/opt/ps2dev/gsKit
ENV PATH="/opt/ps2dev/bin:/opt/ps2dev/ee/bin:/opt/ps2dev/iop/bin:/opt/ps2dev/dvp/bin:/opt/ps2dev/ps2sdk/bin:${PATH}"

FROM llvm AS console-psp
RUN apt-get update && apt-get install -y --no-install-recommends clang-23 \
    && rm -rf /var/lib/apt/lists/* \
    && bash /tmp/install-rust.sh legacy && cargo install cargo-psp --version 0.2.8 --locked
ARG PSPDEV_VERSION=v20261001
RUN mkdir -p /opt/pspdev \
    && curl -fL --retry 3 "https://github.com/pspdev/pspdev/releases/download/${PSPDEV_VERSION}/pspdev-ubuntu-latest-x86_64.tar.gz" -o /tmp/sdk.tar.gz \
    && tar -xzf /tmp/sdk.tar.gz --strip-components=1 -C /opt/pspdev \
    && rm /tmp/sdk.tar.gz \
    && test -x /opt/pspdev/bin/psp-gcc
ENV PSPDEV=/opt/pspdev PSP_CLANG=/usr/lib/llvm-23/bin/clang
ENV PATH="/opt/pspdev/bin:${PATH}"

FROM devkitpro/devkitarm:20260610 AS console-3ds
ENV DEBIAN_FRONTEND=noninteractive CARGO_HOME=/opt/cargo RUSTUP_HOME=/opt/rustup
ENV PATH="/opt/cargo/bin:${PATH}"
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl git python3 file zip unzip pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
COPY consoles/toolchain.env /tmp/toolchain.env
COPY docker/install-console-rust.sh /tmp/install-rust.sh
RUN bash /tmp/install-rust.sh && test -f /opt/devkitpro/libctru/lib/libcitro3d.a
WORKDIR /work
